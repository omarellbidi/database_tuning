1 - Erstellung der Tabellen:

postgres=# CREATE TABLE Employee (
    ssnum    INTEGER PRIMARY KEY,
    name     TEXT,
    manager  TEXT,
    dept     TEXT,
    salary   INTEGER,
    numfriends INTEGER
);

CREATE UNIQUE INDEX employee_name_uniq ON Employee(name);
CREATE INDEX employee_dept_idx ON Employee(dept);

CREATE TABLE Student (
    ssnum    INTEGER PRIMARY KEY,
    name     TEXT,
    course   TEXT,
    grade    INTEGER
);

CREATE UNIQUE INDEX student_name_uniq ON Student(name);

CREATE TABLE Techdept (
    dept     TEXT PRIMARY KEY,
    manager  TEXT,
    location TEXT
);
2 - Datengenerierung:

-- Techdept (10 technische Abteilungen)
INSERT INTO Techdept (dept, manager, location)
SELECT
    'tech' || n                  AS dept,
    'mgr' || n                   AS manager,
    'loc' || n                   AS location
FROM generate_series(1, 10) AS n;

-- 100.000 Employees
INSERT INTO Employee (ssnum, name, manager, dept, salary, numfriends)
SELECT
    n                                                       AS ssnum,
    substring(md5(random()::text), 1, 10)                  AS name,
    'mgr' || (n % 100 + 1)                                 AS manager,
    CASE
        WHEN n % 10 = 0 THEN 'tech' || (floor(random() * 10 + 1)::int)
        ELSE 'non_tech' || (n % 50 + 1)
    END                                                     AS dept,
    floor(30000 + random() * 70000)::int                    AS salary,
    floor(random() * 50)::int                               AS numfriends
FROM generate_series(1, 100000) AS n;

INSERT INTO Student (ssnum, name, course, grade)
SELECT
    n AS ssnum,
    substring(md5(random()::text), 1, 10) AS name,
    CASE
        WHEN n % 3 = 0 THEN 'db'
        WHEN n % 3 = 1 THEN 'algo'
        ELSE 'net'
    END AS course,
    floor(1 + random() * 5)::int AS grade
FROM generate_series(1, 100000) AS n;

3 - Queries (Original und Rewrite)

QUERY A

-- Original
SELECT E.ssnum
FROM Employee E
WHERE EXISTS (
    SELECT 1
    FROM Techdept T
    WHERE T.dept = E.dept
);

-- Rewrite
SELECT E.ssnum
FROM Employee E
JOIN Techdept T
  ON T.dept = E.dept;

QUERY B

-- Original
SELECT E.ssnum
FROM Employee E
WHERE EXISTS (
    SELECT 1
    FROM Techdept T
    WHERE T.dept = E.dept
);

-- Rewrite
SELECT E.ssnum
FROM Employee E
WHERE E.dept IN (
    SELECT T.dept
    FROM Techdept T
);

